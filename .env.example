APP_NAME="N1LUX PETRO"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_THEME=pterodactyl
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_ENVIRONMENT_ONLY=false

# Panel Configuration
PANEL_PORT=8080
PANEL_HOST=0.0.0.0
PANEL_TIMEZONE=Asia/Kolkata

# Multi-Language Application Hosting (Docker-Free)
APPLICATIONS_ROOT=/var/lib/n1x/applications
APPLICATION_DEFAULT_PORT=5000
APPLICATION_PORT_RANGE_START=5000
APPLICATION_PORT_RANGE_END=9000
APPLICATION_DEFAULT_RUNTIME=node
APPLICATION_MAX_COUNT=20

# Native Process Management
PROCESS_MANAGER=systemd
NODE_PROCESS_MANAGER=pm2

# Reverse Proxy (Nginx)
NGINX_ENABLED=true
NGINX_CONFIG_PATH=/etc/nginx/conf.d

# Security and Isolation
APPLICATION_USER_PREFIX=n1x-app
APPLICATION_RUN_AS_UNPRIVILEGED=true

# Application Logging
APPLICATION_LOG_PATH=/var/log/n1x
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panel
DB_USERNAME=pterodactyl
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=file
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

HASHIDS_SALT=
HASHIDS_LENGTH=8

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="N1LUX PETRO"
# MAIL_EHLO_DOMAIN=panel.example.com
